# Copy this file to .env.local for local development. Never commit real values.
# `npm run setup` can create a mode-0600 .env.local and generate the two random
# secrets below without printing them.

# Required. Use a normal PostgreSQL URL locally. On serverless hosting, use the
# provider's pooled URL here.
DATABASE_URL=

# Optional direct database URL for migrations. Neon users should set this to
# the non-pooler URL. It may equal DATABASE_URL on ordinary PostgreSQL.
DATABASE_URL_UNPOOLED=

# Required for login and encrypted sessions. Generate these with npm run setup.
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Optional. Enables the owner-facing MCP endpoint. HERMES_API_TOKEN remains a
# compatibility alias, but new installations should use OWNER_MCP_TOKEN.
# OWNER_MCP_TOKEN=

# Optional automation. Leave these unset until a worker is installed.
# Each token must be at least 32 characters and different from every other role.
# COMPASS_WORKERS_JSON=
# COMPASS_SCHEDULER_TOKEN=

# Optional LinkedIn collector credential. LinkedIn collection also requires a
# separately configured browser provider and the account owner's own login.
# LINKEDIN_COLLECTOR_TOKEN=

# Local development only. Production and Vercel previews ignore this switch.
COMPASS_OPEN_ACCESS=0

# Optional deployment revision shown by /api/health. Set to your Git commit SHA.
# JOB_SEEKER_SOURCE_REVISION=
