[Unit]
Description=Job Seeker bounded worker poll
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=job-seeker
Group=job-seeker
WorkingDirectory=/opt/job-seeker
EnvironmentFile=/etc/job-seeker/worker.env
ExecStart=/opt/job-seeker/.venv/bin/job-seeker-worker --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/job-seeker
